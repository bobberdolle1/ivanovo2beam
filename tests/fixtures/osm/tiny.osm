<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written fixture for tests/test_osm.py. It is NOT real OSM data, but the
  coordinates sit in central Ivanovo and the tagging mirrors what a real
  Overpass response contains, including the parts that break naive parsers:
  a Cyrillic name, an XML entity, a way whose node is outside the extract, a
  closed way that is not an area, and untagged multipolygon member ways.
-->
<osm version="0.6" generator="ivanovo2beam test fixture">
  <bounds minlat="56.9900" minlon="40.9600" maxlat="57.0100" maxlon="40.9800"/>
  <meta osm_base="2026-01-01T00:00:00Z"/>
  <note>The data included in this document is from www.openstreetmap.org.</note>

  <!-- ул. Ленина: an open highway way -->
  <node id="101" lat="56.9900" lon="40.9600"/>
  <node id="102" lat="56.9905" lon="40.9650"/>
  <node id="103" lat="56.9910" lon="40.9700"/>
  <node id="104" lat="56.9915" lon="40.9750"/>
  <node id="105" lat="56.9920" lon="40.9800"/>

  <!-- a closed building footprint -->
  <node id="106" lat="56.9930" lon="40.9610"/>
  <node id="107" lat="56.9930" lon="40.9620"/>
  <node id="108" lat="56.9940" lon="40.9620"/>
  <node id="109" lat="56.9940" lon="40.9610"/>

  <!-- a closed roundabout: closed, but a road, not an area -->
  <node id="110" lat="56.9950" lon="40.9630"/>
  <node id="111" lat="56.9952" lon="40.9634"/>
  <node id="112" lat="56.9950" lon="40.9638"/>
  <node id="113" lat="56.9948" lon="40.9634"/>

  <!-- a river; node 999 is deliberately absent (outside the extract) -->
  <node id="114" lat="56.9960" lon="40.9650"/>
  <node id="115" lat="56.9965" lon="40.9660"/>

  <!-- tagged nodes: a place label, a café and a shop name with an entity -->
  <node id="120" lat="57.0000" lon="40.9700">
    <tag k="place" v="suburb"/>
    <tag k="name" v="Центр"/>
  </node>
  <node id="121" lat="56.9985" lon="40.9710">
    <tag k="amenity" v="cafe"/>
    <tag k="name" v="Кафе «Уют»"/>
  </node>
  <node id="122" lat="56.9980" lon="40.9720">
    <tag k="shop" v="bakery"/>
    <tag k="name" v="Хлеб &amp; Соль"/>
  </node>

  <!-- untagged rings: the members of the water multipolygon below -->
  <node id="130" lat="56.9800" lon="40.9800"/>
  <node id="131" lat="56.9800" lon="40.9820"/>
  <node id="132" lat="56.9810" lon="40.9820"/>
  <node id="133" lat="56.9810" lon="40.9800"/>
  <node id="134" lat="56.9803" lon="40.9805"/>
  <node id="135" lat="56.9803" lon="40.9810"/>
  <node id="136" lat="56.9807" lon="40.9810"/>
  <node id="137" lat="56.9807" lon="40.9805"/>

  <way id="201">
    <nd ref="106"/>
    <nd ref="107"/>
    <nd ref="108"/>
    <nd ref="109"/>
    <nd ref="106"/>
    <tag k="building" v="yes"/>
    <tag k="building:levels" v="3"/>
  </way>

  <way id="202">
    <nd ref="101"/>
    <nd ref="102"/>
    <nd ref="103"/>
    <nd ref="104"/>
    <nd ref="105"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="улица Ленина"/>
    <tag k="maxspeed" v="60"/>
  </way>

  <way id="203">
    <nd ref="110"/>
    <nd ref="111"/>
    <nd ref="112"/>
    <nd ref="113"/>
    <nd ref="110"/>
    <tag k="highway" v="primary"/>
    <tag k="junction" v="roundabout"/>
  </way>

  <way id="204">
    <nd ref="114"/>
    <nd ref="115"/>
    <nd ref="999"/>
    <tag k="waterway" v="river"/>
    <tag k="name" v="Уводь"/>
  </way>

  <way id="205">
    <nd ref="130"/>
    <nd ref="131"/>
    <nd ref="132"/>
    <nd ref="133"/>
    <nd ref="130"/>
  </way>

  <way id="206">
    <nd ref="134"/>
    <nd ref="135"/>
    <nd ref="136"/>
    <nd ref="137"/>
    <nd ref="134"/>
  </way>

  <relation id="301">
    <member type="way" ref="205" role="outer"/>
    <member type="way" ref="206" role="inner"/>
    <tag k="type" v="multipolygon"/>
    <tag k="natural" v="water"/>
    <tag k="name" v="пруд у мельницы"/>
  </relation>

  <relation id="302">
    <member type="way" ref="205" role="outer"/>
    <member type="node" ref="120" role="admin_centre"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="8"/>
  </relation>
</osm>
