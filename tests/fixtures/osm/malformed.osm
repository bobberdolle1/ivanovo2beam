<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture for tests/test_osm.py: one deliberately broken element of each kind
  next to good data. A tolerant parser must drop the broken parts, keep the
  good ones, and never raise. Expected survivors:

    nodes 1, 5, 6   (6 keeps its malformed <tag/> dropped, the node itself stays)
    ways  10, 12    (11 has one usable <nd>, "x" is not an id)
    relation 20     (one of its three members is usable)
-->
<osm version="0.6" generator="ivanovo2beam test fixture">
  <node id="1" lat="56.9900" lon="40.9600"/>
  <node id="oops" lat="56.9901" lon="40.9601"/>
  <node id="3" lat="not-a-number" lon="40.9602"/>
  <node id="4" lat="999.0" lon="40.9603"/>
  <node id="5" lat="56.9904" lon="40.9604"/>
  <node id="6" lat="56.9905" lon="40.9605">
    <tag k="name"/>
  </node>

  <way id="10">
    <nd ref="1"/>
    <nd ref="5"/>
  </way>

  <way id="11">
    <nd ref="1"/>
    <nd ref="bogus"/>
  </way>

  <way id="x">
    <nd ref="1"/>
    <nd ref="5"/>
  </way>

  <way id="12">
    <nd ref="1"/>
    <nd ref="5"/>
    <tag k="highway" v="track"/>
    <tag k="name"/>
  </way>

  <relation id="20">
    <member type="way" ref="10" role="outer"/>
    <member type="bogus" ref="10" role="outer"/>
    <member type="way" ref="oops" role="inner"/>
    <tag k="type" v="multipolygon"/>
  </relation>
</osm>
