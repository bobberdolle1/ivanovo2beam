<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture for tests/test_osm.py: an Overpass response that carries HTTP 200 but
  reports a query timeout in a <remark> element. Silently treating this as an
  empty extract would poison every downstream stage, so parse_osm must raise.
-->
<osm version="0.6" generator="Overpass API 0.7.62.4 2390de5a">
  <note>The data included in this document is from www.openstreetmap.org.</note>
  <meta osm_base="2026-10-07T18:00:00Z"/>
  <remark> runtime error: Query timed out in "query" at line 3 after 180 seconds. </remark>
</osm>
