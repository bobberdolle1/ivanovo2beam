*.osm.pbf
*.osm.bz2
*.tif
*.tiff
*.hgt
*.dem
!tests/fixtures/**/*.tif

# BeamNG build artefacts
*.ter
*.cdae
*.dae
*.dds
!tests/fixtures/**/*.ter
