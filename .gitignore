# Generated output — never commit generated assets
build/
dist/
*.egg-info/
.eggs/

# Cache of downloaded / derived geodata
.cache/
.scratch/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

